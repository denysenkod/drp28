TRYON_HOST=127.0.0.1
TRYON_PORT=7860

# mock = test the page, upload flow, and mask generation without AI model weights.
# diffusers = run SDXL inpainting directly in Python/PyTorch.
TRYON_BACKEND=mock

# Optional for gated Hugging Face models. Leave blank for public models.
HF_TOKEN=

# Diffusers backend settings.
DIFFUSERS_MODEL=diffusers/stable-diffusion-xl-1.0-inpainting-0.1
DIFFUSERS_DEVICE=cuda
DIFFUSERS_VARIANT=fp16
DIFFUSERS_WIDTH=768
DIFFUSERS_HEIGHT=768
DIFFUSERS_STRENGTH=0.86

# Optional image guidance. This is useful after the base inpainting path works.
IP_ADAPTER_REPO=
IP_ADAPTER_SUBFOLDER=
IP_ADAPTER_WEIGHT_NAME=
IP_ADAPTER_SCALE=0.45
